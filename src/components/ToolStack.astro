---
interface Tool {
  name: string;
}

interface Props {
  tools: Tool[];
}

const { tools } = Astro.props;
---

<h3 class="tool-stack__heading">Tools Used</h3>

<div class="tool-stack">
  {
    tools.map((tool) => (
      <div class="tool-stack__tag">
        <span class="tool-stack__name">{tool.name}</span>
      </div>
    ))
  }
</div>

<style>
  .tool-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .tool-stack__heading {
    font-size: var(--text-heading-sm);
    width: 100%;
  }

  .tool-stack__tag {
    padding: var(--space-xs);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background-color: transparent;
    display: inline-block;
  }

  .tool-stack__name {
    font-size: var(--text-body);
    white-space: nowrap;
    line-height: 0.75;
  }
</style>
