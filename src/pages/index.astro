---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import HireStatus from "../components/HireStatus.astro";
import FeaturedGrid from "../components/FeaturedGrid.astro";
import { Image } from "astro:assets";
// IMPORT IMAGES
import selfPortraitSmall from "../assets/images/homepage/sm-port-grey7.png";
import selfPortrait from "../assets/images/homepage/lg-port-grey-sign.png";

import AchievementCard from "../components/AchievementCard.astro";
import { achievementData } from "../data/achievementData";
---

<Layout title="K4D3">
  <Container>
    <header class="home-hero">
      <div class="portrait-container">
        <Image
          src={selfPortraitSmall}
          alt="temp self portrait"
          loading="eager"
        />
      </div>

      <h1>
        I'm Kade, a <strong>Designer</strong> with a passion for
        {" "}
        <strong>IT/Cybersecurity.</strong>
      </h1>

      <p>
        I'm currently a Cybersecurity student <span class="text-highlight">
          transitioning into IT/Security
        </span>{" "}
        with a creative background in Graphic Design and Front-End Web Development.
      </p>

      <HireStatus />
    </header>

    <FeaturedGrid />

    <section id="about">
      <div class="about-container">
        <div class="about-container__left">
          <h2>About</h2>

          <div class="about-container__text prose prose-invert">
            <p>
              My introduction to design came at a young age with strong
              ambitions to learn and create high-quality work. While I have
              expanded my interests with IT and Cybersecurity, these ambitions
              continue to drive my projects today.
            </p>
            <p>
              My passion for Cybersecurity was sparked by an unfortunate hacking
              incident that resulted from a company data breach. To make a story
              short, I stepped up and{" "}
              <a href="/blog/the-hacked-account">disrupted the hack</a>, which I
              feel proud of.
            </p>
            <p>
              As a victim of data breaches, I hope to make a difference in
              protecting people and the organizations we rely on.
            </p>
            <p>
              Apart from my work, I enjoy exercising, playing video games,
              watching anti-scam creators, and <a href="/work/home-lab"
                >homelabbing</a
              >!
            </p>
            <p>
              I’m currently in school for Cybersecurity, and exploring new
              hiring opportunities. I'd love to hear from you — {" "}
              <a href="mailto:hi@k4d3.com">hi@k4d3.com</a>.
            </p>
          </div>
        </div>

        <aside>
          <div class="self-port__wrapper">
            <Image src={selfPortrait} alt="temp self portrait" />
          </div>
        </aside>
      </div>

      <AchievementCard achievements={achievementData} />
    </section>
  </Container>
</Layout>

<style>
  .home-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }
  .home-hero h1 {
    font-size: var(--text-display-sm);
    font-weight: 400;
  }
  .home-hero p {
    font-size: var(--text-body-lg);
    max-width: 50ch;
    margin: 0;
  }

  strong {
    font-weight: 900;
  }

  .portrait-container {
    width: clamp(6rem, 7vw, 8rem);
  }
  .portrait-container img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .projects-container {
    padding-bottom: var(--space-md);
    border-bottom: var(--border);
    margin-bottom: var(--space-xl);
    position: relative;
  }
  .project-section__more {
    text-transform: uppercase;
    white-space: nowrap;
    line-height: 0.6;
    position: absolute;
    bottom: -7.5px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-bg);
    padding: 0 1rem 0 1rem;
    z-index: 2;
  }
  .project-section__endline {
    height: 1px;
    width: 100%;
    background-color: var(--color-border);
  }

  .projects-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .header-section {
    /* padding-left: var(--space-md); */
  }

  .header-subsection {
    padding-bottom: var(--space-md);
  }
  .section-label {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  @media (max-width: 400px) {
    .home-hero h1 {
      font-size: var(--text-heading-xl);
    }
  }

  /* || ABOUT SECTION */

  .about-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }
  .about-container__left h2 {
    margin-bottom: var(--space-lg);
  }
  .about-container__text {
    max-width: 54ch;
  }
  .about-container__tagline {
    margin-bottom: var(--space-md);
  }
  .about-container__tagline p {
    font-weight: 400;
  }

  .self-port__wrapper {
    max-width: 30rem;
  }

  @media (max-width: 1080px) {
    .about-container {
      flex-direction: column;
      gap: var(--space-lg-2);
    }

    .about-container__text {
      max-width: 65ch;
    }
  }
</style>
