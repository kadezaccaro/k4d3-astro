---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import { Image } from "astro:assets";

import { getCollection } from "astro:content";
const posts = await getCollection("posts");
---

<Layout title="Blog | K4D3">
  <Container size="sm">
    <h1 class="pad-bottom-lg">Blog</h1>

    <div class="blog-flex-container">
      {
        posts.map((post) => (
          <a href={`/blog/${post.id}`}>
            <article class="blog-article">
              <header class="blog-article__header">
                <span class="tag">{post.data.date}</span>
                <span class="tag">{post.data.readTime}</span>
              </header>
              <figure>
                <div class="img-container">
                  <Image
                    src={post.data.cover}
                    alt={post.data.coverAlt}
                    width={1400}
                    height={600}
                  />
                </div>

                <figcaption class="blog-article__details">
                  <h2>{post.data.title}</h2>
                  <p>{post.data.description}</p>
                </figcaption>
              </figure>
            </article>
          </a>
        ))
      }
    </div>
  </Container>
</Layout>

<style>
  .blog-flex-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .blog-article {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    overflow: hidden;
    /* padding: var(--space-md); */
  }
  .blog-article__header {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    color: var(--color-text-level-2);
    padding: var(--space-sm) var(--space-sm-2);
  }

  .blog-article:hover img {
    transform: scale(1.05);
  }
  .img-container {
    overflow: hidden;
    /* border-radius: 0.25rem; */
    border-right: 1px solid var(--color-border);
  }
  .blog-article img {
    height: 100%;
    transition: transform 0.5s ease;
  }

  .blog-article__details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg-2);
    padding: var(--space-sm-2);
  }
  .blog-article__details h2 {
    font-size: var(--text-heading-sm);
    line-height: 1;
    font-weight: 700;
    white-space: nowrap;
    /* text-transform: uppercase; */
    /* font-family: "Roboto Mono", monospace; */
  }
  .blog-article__details p {
    justify-self: end;
    /* font-family: "Roboto Mono", monospace; */
    /* font-size: var(--text-caption); */
    /* color: var(--color-text-level-1); */
    line-height: 1.4;
  }

  .article-extras {
    margin-top: var(--space-xs);
  }
  .article-extras .tag {
    font-size: var(--text-body);
  }

  .tag {
    font-size: var(--text-body);
    font-size: var(--text-caption);
    line-height: var(--leading-tight);
    /* text-transform: uppercase; */
    font-family: "Roboto Mono", monospace;
    /* margin: 0; */
  }

  @media (max-width: 800px) {
    .blog-article__header {
    }
    .blog-article__details {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
      text-align: center;
    }
    .blog-article__details p {
      justify-self: start;
    }
  }
</style>
