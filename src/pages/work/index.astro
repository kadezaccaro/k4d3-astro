---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";

const projects = await getCollection("projects");

const sortedProjects = projects.sort((a, b) => {
  // Prioritize featured projects
  if (a.data.featured !== b.data.featured) {
    return b.data.featured ? 1 : -1;
  }

  // Sort featured projects by custom order
  if (a.data.featured) {
    return (
      (a.data.featuredOrder ?? Infinity) - (b.data.featuredOrder ?? Infinity)
    );
  }

  // Sort non-featured projects alphabetically
  return a.data.title.localeCompare(b.data.title);
});
---

<Layout title="Work">
  <Container>
    <h1 class="pad-bottom-lg">Work</h1>

    <div class="projects-container">
      <div class="project-filters" aria-label="Filter projects">
        <button class="filter-button active" data-filter="all">All Work</button>
        <button class="filter-button" data-filter="it">IT/Security</button>
        <button class="filter-button" data-filter="design"
          >Graphic Design</button
        >
      </div>

      <div class="grid-auto-fit">
        {
          sortedProjects.map((project) => (
            <div class="project-item" data-category={project.data.category}>
              <ProjectCard
                href={`/work/${project.id}`}
                title={project.data.title}
                description={project.data.summary}
                image={project.data.cover}
                imageAlt={project.data.coverAlt}
                tag={project.data.tag}
                isAboveFold={project.data.featured}
              />
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</Layout>

<script>
  function initProjectFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>(
      ".project-filters [data-filter]",
    );

    const projects = document.querySelectorAll<HTMLElement>(
      ".project-item[data-category]",
    );

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter;

        buttons.forEach((btn) => btn.classList.remove("active"));

        button.classList.add("active");

        projects.forEach((project) => {
          const category = project.dataset.category;

          project.hidden = filter !== "all" && category !== filter;
        });
      });
    });
  }

  document.addEventListener("astro:page-load", initProjectFilters);
</script>

<style>
  .projects-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .project-filters {
    display: flex;
    /* justify-content: center; */
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .filter-button {
    cursor: pointer;
    font-size: var(--text-caption);
    border: var(--border);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    line-height: 1;
    transition: 0.2s;
    color: var(--color-text-level-1);
    font-family: "Roboto Mono", monospace;
    text-transform: uppercase;
    font-weight: 500;
    background-color: var(--color-surface);
  }
  .filter-button.active {
    /* border-color: var(--color-primary); */
    /* color: var(--color-text-level-1); */
    background-color: var(--color-text-level-1);
    color: var(--color-bg);
  }

  .project-item[hidden] {
    display: none;
  }
</style>
