---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  href: string;
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  tag: string;
  isAboveFold?: boolean;
}

const {
  href,
  title,
  description,
  image,
  imageAlt,
  tag,
  isAboveFold = false,
} = Astro.props;

// Import the image dynamically from the content folder
// const image = await import(`../content/projects/${projectid}/thumbnail.jpg`);
---

<a href={href}>
  <article class="project-card">
    <div class="project-card__cover">
      <Image
        src={image}
        alt={imageAlt}
        widths={[320, 640, 1024]}
        loading={isAboveFold ? "eager" : "lazy"}
      />
    </div>
    <h4>{title}</h4>
    <p>{description}</p>
    <p class="tag">{tag}</p>
  </article>
</a>

<!--  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw" -->

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm-2);
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    overflow: hidden;
    height: 100%;
    font-family: "Satoshi", sans-serif;
    transition: 0.2s ease-in-out;
    color: inherit;
  }
  .project-card__cover {
    border-radius: var(--radius-lg);
    border-bottom: var(--border);
    overflow: hidden;
  }
  .project-card h4,
  .project-card p {
    padding-inline: var(--space-sm-2);
  }
  .project-card p {
    line-height: 1.5;
    margin-bottom: 0;
  }
  .project-card .tag {
    font-family: "Roboto Mono", monospace;
    font-size: var(--font-size-caption);
    margin-top: auto; /* make tags align at bottom of cards */
    padding-bottom: var(--space-sm-2);
  }
  .project-card:hover {
    transform: scale(1.02);
    color: inherit;
  }
</style>
