---
interface Props {
  currentYear?: number;
}

const { currentYear = new Date().getFullYear() } = Astro.props;

import Container from "./Container.astro";
---

<footer>
  <div class="divider layered-steps-end"></div>

  <Container>
    <div class="footer-content">
      <div class="footer-section">
        <a href="/" class="logo">K4D3</a>
        <p>
          A passionate creative pivoting into IT & Cybersecurity, bringing close
          attention to detail and problem solving.
        </p>
      </div>

      <div class="footer-section">
        <h2>Navigation</h2>
        <ul>
          <li>
            <a href="/">Home</a>
          </li>
          <li>
            <a href="/work">Work</a>
          </li>
          <li>
            <a href="/#about">About</a>
          </li>
          <li>
            <a href="/blog">Blog</a>
          </li>
          <li>
            <a href="/contact">Contact</a>
          </li>
        </ul>
      </div>

      <div class="footer-section">
        <h2>Social</h2>
        <div class="social-links">
          <ul>
            <li>
              <a
                href="https://www.github.com/"
                target="_blank"
                rel="noopener"
                aria-label="Visit github.com (opens in a new tab)"
              >
                GitHub
              </a>
            </li>
            <li>
              <a
                href="https://www.instagram.com/"
                target="_blank"
                rel="noopener"
                aria-label="Visit instagram.com (opens in a new tab)"
              >
                Instagram
              </a>
            </li>
            <li>
              <a
                href="https://www.linkedin.com/"
                target="_blank"
                rel="noopener"
                aria-label="Visit linkedin.com (opens in a new tab)"
              >
                LinkedIn
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </Container>

  <div class="footer-bottom">
    <Container>
      <div class="footer-bottom-content">
        <p>© {currentYear} K4D3</p>
        <p>Coded with passion ❤</p>
      </div>
    </Container>
  </div>
</footer>

<style>
  /* Footer Content Grid */
  .footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-lg-2);
    padding-block: var(--space-xl);
  }

  .logo {
    font-weight: 700;
    text-decoration: none;
    font-family: "Satoshi", sans-serif;
    font-size: var(--text-heading-md);
    line-height: var(--leading-tight);
  }

  /* Footer Section */
  .footer-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .footer-section p {
    max-width: 45ch;
  }
  .footer-section h2 {
    font-size: var(--text-body);
    font-weight: normal;
    color: var(--color-text-level-2);
    letter-spacing: unset;
  }
  .footer-section ul {
    list-style: none;
  }
  .footer-section li {
    border-bottom: 1px solid var(--color-border);
    transition: 0.2s;
  }
  .footer-section li:last-child {
    border-bottom: none;
  }
  .footer-section li a {
    /* Ensure the link covers the entire list item */
    display: block;
    padding: var(--space-xs) 0;
    font-family: "Roboto Mono", monospace;
    font-size: var(--text-body);
  }

  .footer-section li:first-child a {
    padding-top: 0;
  }
  .footer-section li:last-child a {
    padding-bottom: 0;
  }
  .footer-section li:hover {
    padding-left: 0.25rem;
    color: var(--color-secondary);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-md);
  }
  .footer-bottom-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .footer-bottom-content p {
    font-size: var(--text-caption);
    line-height: var(--leading-tight);
    margin: 0;
  }

  @media (max-width: 880px) {
    .footer-content {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-lg);
      padding-block: var(--space-xl);
    }
  }

  @media (max-width: 400px) {
    .footer-bottom-content {
      flex-direction: column;
      gap: var(--space-xs);
    }
  }
</style>
