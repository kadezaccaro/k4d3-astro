---
interface Props {
  emphasis?: "left" | "right";
}

const { emphasis = "right" } = Astro.props;
---

<section class={`two-column ${emphasis}`}>
  <slot />
</section>

<style>
  .two-column {
    display: grid;
    gap: var(--space-md);
    /* margin-bottom: var(--space-xl); */
    /* border-top: 1px solid var(--color-border); */
    /* padding-top: var(--space-md); */
    /* justify-items: center; */
    /* align-items: center; */
  }
  .two-column.left {
    grid-template-columns: 2fr 1fr;
  }
  .two-column.right {
    grid-template-columns: 1fr 2fr;
  }

  @media (max-width: 768px) {
    .two-column {
      display: flex;
      flex-direction: column;
    }
    .two-column.left {
      flex-direction: column-reverse;
    }
  }
</style>
